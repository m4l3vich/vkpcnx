diff --git a/src/udp.c b/src/udp.c
index fddd773..71b5a8c 100644
--- a/src/udp.c
+++ b/src/udp.c
@@ -396,6 +396,43 @@ static int has_duplicate_addr(struct sockaddr *addr, const addr_record_t *record
 	return false;
 }
 
+#if defined(__SWITCH__)
+// The libnx BSD socket layer has neither getifaddrs() nor SIOCGIFCONF; the
+// console has a single network interface, so ask the stack which local
+// address it would use to reach a public host (nothing is sent: UDP connect()
+// only selects the route).
+static int get_local_default_inet4(uint16_t port, struct sockaddr_in *result) {
+	struct sockaddr_in sin;
+	memset(&sin, 0, sizeof(sin));
+	sin.sin_family = AF_INET;
+	sin.sin_port = htons(9); // discard port
+	if (inet_pton(AF_INET, "192.0.2.1", &sin.sin_addr) != 1) // TEST-NET-1, unreachable
+		return -1;
+
+	socket_t sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+	if (sock == INVALID_SOCKET)
+		return -1;
+
+	if (connect(sock, (const struct sockaddr *)&sin, sizeof(sin)))
+		goto error;
+
+	socklen_t result_len = sizeof(*result);
+	if (getsockname(sock, (struct sockaddr *)result, &result_len))
+		goto error;
+
+	if (result_len != sizeof(*result) || result->sin_addr.s_addr == htonl(INADDR_ANY))
+		goto error;
+
+	addr_set_port((struct sockaddr *)result, port);
+	closesocket(sock);
+	return 0;
+
+error:
+	closesocket(sock);
+	return -1;
+}
+#endif
+
 #if !defined(_WIN32) && defined(NO_IFADDRS)
