<brls:Box grow="1" axis="row" padding="30" alignItems="center" justifyContent="center">
  <brls:Image width="200" height="325" image="@res/img/onboarding_graphic.png"/>
  <brls:Box axis="column" maxWidth="600" marginLeft="100" minHeight="325">
    <brls:Label text="Перед началом игры" marginBottom="30" fontSize="40"/>
