<brls:Box axis="row" padding="30" width="auto" height="auto">
  <brls:Box axis="column" marginRight="60" grow="1">
    <brls:Label text="Выберите, как касание сенсорного экрана будет управлять указателем мыши." marginBottom="20"/>

    <brls:Padding/>

    <brls:Label text="Выберите режим" fontSize="15" alpha="0.5" marginBottom="20"/>
    <brls:Box lineColor="@theme/brls/applet_frame/separator" lineBottom="1px" alpha="0.25"/>
    <brls:RadioCell id="onboarding/touchscreen_mode/touchscreen_radio" title="Тачскрин"/>
    <brls:RadioCell id="onboarding/touchscreen_mode/trackpad_radio" title="Трекпад"/>

    <brls:Padding/>

    <brls:Box>
      <brls:Button id="onboarding/touchscreen_mode/next" text="Продолжить" style="primary" marginRight="20"/>
      <brls:Button id="onboarding/touchscreen_mode/back" text="Назад" style="default"/>
    </brls:Box>
  </brls:Box>
  <brls:Box axis="column" alignItems="center" width="600">
    <brls:Box axis="column" alignItems="center" width="100%" marginBottom="20">
      <vkpcnx:AnimatedWebp cornerRadius="10" id="onboarding/touchscreen_mode/anim" loop="true" autoplay="true" width="380" height="220" scalingType="fill"/>
    </brls:Box>

    <brls:Label id="onboarding/touchscreen_mode/trackpad_desc" text="Трекпад — нажмите и ведите пальцем по экрану, указатель будет повторять движение. Для левого клика быстро нажмите на экран. Чтобы перетащить что-то, нажмите и сразу снова коснитесь экрана и ведите пальцем. Для правого клика быстро нажмите на экран двумя пальцами."  marginBottom="20"/>
    <brls:Label id="onboarding/touchscreen_mode/touchscreen_desc" text="Тачскрин — при нажатии на экран указатель переместится в место нажатия и сделает левый клик мышью. Для правого клика удерживайте палец на экране."  marginBottom="20"/>
  </brls:Box>
</brls:Box>