    <brls:Box padding="16" backgroundColor="#ffffff" cornerRadius="8" marginBottom="20">
      <vkpcnx:QrCode width="128" height="128" text="https://github.com/m4l3vich/vkpcnx"/>
    </brls:Box>
    <brls:Label alpha="0.75" horizontalAlign="center" text="github.com/m4l3vich/vkpcnx" marginBottom="10"/>
