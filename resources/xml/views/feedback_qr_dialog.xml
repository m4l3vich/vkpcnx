  <brls:Box axis="column" alignItems="center" justifyContent="center" grow="1" width="0">
    <brls:Box padding="16" backgroundColor="#ffffff" cornerRadius="8" marginBottom="20">
      <vkpcnx:QrCode width="128" height="128" text="tg://resolve?domain=vkpcnx"/>
    </brls:Box>
    <brls:Label alpha="0.75" horizontalAlign="center" text="t.me/vkpcnx" marginBottom="10"/>
